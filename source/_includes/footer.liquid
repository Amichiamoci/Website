<footer id="contacts">
  <div class="grid">
    <div class="column col-30">
      <h4>Social</h4>
      <div class="social">
        {% for social in site.socials %}
          <a
            target="_blank"
            href="{{ social.link }}"
            title="{{ social.title }}">
            <i class="{{ social.icon }}"></i>
          </a>
        {% endfor %}
      </div>
      <img src="{{ "/assets/images/logo.png" | relative_url }}" alt="Footer banner">
    </div>
    <div class="column col-30">
      <h4>Link utili</h4>
      <div class="links">
        <a href="mailto:info@amichiamoci.it">
          <i class="fa-solid fa-envelope"></i>
          info@amichiamoci.it
        </a>
        <a target="_blank" href="https://www.diocesilivorno.it/">
          <i class="fa-solid fa-location-dot"></i>
          Diocesi di Livorno
        </a>
        <div class="legal">
          <a href="{{ "/crediti" | relative_url }}">Crediti</a>
          <a href="{{ "/privacy" | relative_url }}">Privacy</a>
          <a href="{{ "/regolamenti" | relative_url }}">Regolamenti</a>
        </div>
        {% if site.staff_panel %}
          <a
            href="{{ site.staff_panel }}"
            target="_blank"
            title="Vai al Portale Staff">Portale Staff</a>
        {% endif %}
      </div>
    </div>
    <div class="column col-40">
      <div id="leaflet-map"></div>
    </div>
  </div>
</footer>
<div class="bottom-bar">
  <div class="grid">
    <div class="column col-100">
      <p>
        <strong>
          &copy; Amichiamoci
        </strong>
        {{ "now" | date: "%Y" }}
      </p>
      <hr style="margin: .5em auto; width: 75%;">
    </div>
    <div class="column col-70">
      <p>
        Questo sito è stato realizzato da umani. <br>
        Nessua intelligenza artificiale è stata coinvolta nella sua creazione.
      </p>
    </div>
    <div class="column col-30">
      <a
        href="https://no-ai-icon.com/statement/?url=Amichiamoci"
        target="_blank"
        title="Fatto da umani con Amore">
        <img
          src="{{ "/assets/images/sponsors/human-made-icon.svg" | relative_url }}"
          alt="Fatto da umani"
          height="45">
      </a>
    </div>
  </div>
</div>